<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Reads Parquet files from Amazon S3 (and S3 compatible storage) for ParquetNeo: only the byte ranges that are needed are requested.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" />
    <ProjectReference Include="..\ParquetNeo\ParquetNeo.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ParquetNeo.Storage.S3.Tests" />
  </ItemGroup>

</Project>
