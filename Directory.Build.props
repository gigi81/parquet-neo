<Project>
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- The packages support the current release of .NET and the one before it (long term support); tests run on both. -->
    <LibraryTargetFrameworks>net10.0;net11.0</LibraryTargetFrameworks>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>Luigi Grilli</Authors>
    <Product>A high-performance .NET library for reading and writing Apache Parquet files</Product>
    <PackageProjectUrl>https://gigi81.github.io/parquet-neo/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/gigi81/parquet-neo</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryRoot>$(MSBuildThisFileDirectory)</RepositoryRoot>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>parquet;apache-parquet;columnar;serialization;aot</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <!-- Builds on the CI servers are deterministic, so that a package can be rebuilt byte for byte from its tag. -->
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
