<Project>
  <PropertyGroup>
    <AssemblyVersion>1.0.0</AssemblyVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>Luigi Grilli</Authors>
    <Product>A high-performance .NET library for reading and writing Apache Parquet files</Product>
    <PackageProjectUrl>https://github.com/gigi81/parquet-neo</PackageProjectUrl>
    <RepositoryUrl>https://github.com/gigi81/parquet-neo</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryRoot>$(MSBuildThisFileDirectory)</RepositoryRoot>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>
</Project>
