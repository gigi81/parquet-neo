<Project Sdk="Microsoft.NET.Sdk">

  <!-- Helpers shared by the test projects of the libraries; it has no tests of its own. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Library</OutputType>
    <IsTestProject>false</IsTestProject>
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
    <GenerateTestingPlatformEntryPoint>false</GenerateTestingPlatformEntryPoint>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ParquetNeo\ParquetNeo.csproj" />
    <ProjectReference Include="..\..\src\ParquetNeo.Compression.Lz4\ParquetNeo.Compression.Lz4.csproj" />
    <ProjectReference Include="..\..\src\ParquetNeo.Compression.Snappy\ParquetNeo.Compression.Snappy.csproj" />
    <ProjectReference Include="..\..\src\ParquetNeo.Compression.Zstd\ParquetNeo.Compression.Zstd.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The helpers that use internals of the libraries are internal here, and are used by the test projects of the libraries. -->
    <InternalsVisibleTo Include="ParquetNeo.Tests" />
    <InternalsVisibleTo Include="ParquetNeo.Serialization.Tests" />
  </ItemGroup>

</Project>
